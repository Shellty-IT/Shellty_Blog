@model PostListItemViewModel

<article class="card post-card h-100">
    <a asp-controller="BlogPost" asp-action="Post" asp-route-id="@Model.Id" class="post-card-media" tabindex="-1" aria-hidden="true">
        @if (Model.HasImage)
        {
            <img src="@Url.Action("GetImage", "BlogPost", new { id = Model.Id })"
                 alt=""
                 class="card-img-top"
                 loading="lazy" />
        }
        else
        {
            <span class="post-card-placeholder"><i class="bi bi-journal-text" aria-hidden="true"></i></span>
        }
    </a>
    <div class="card-body d-flex flex-column">
        @if (!string.IsNullOrWhiteSpace(Model.Category))
        {
            <a asp-controller="BlogPost" asp-action="Posts" asp-route-category="@Model.Category" class="badge badge-category align-self-start">
                <span class="visually-hidden">Category </span>@Model.Category
            </a>
        }
        <h3 class="card-title">
            <a asp-controller="BlogPost" asp-action="Post" asp-route-id="@Model.Id">@Model.Title</a>
        </h3>
        <div class="post-meta-item" aria-label="Post details">
            <span><i class="bi bi-calendar3" aria-hidden="true"></i> @Model.CreatedDate.ToString("MMM dd, yyyy")</span>
            <span><i class="bi bi-clock" aria-hidden="true"></i> @Model.ReadingTimeMinutes min read</span>
        </div>
        <p class="card-text flex-grow-1">@Model.Excerpt</p>
        <a asp-controller="BlogPost" asp-action="Post" asp-route-id="@Model.Id" class="post-card-link">
            Read More <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
        </a>
    </div>
</article>
