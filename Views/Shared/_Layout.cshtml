@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isSignedIn = SignInManager.IsSignedIn(User);
    var currentUser = isSignedIn ? await UserManager.GetUserAsync(User) : null;
    var displayName = currentUser?.DisplayName ?? User.Identity?.Name ?? "Account";
    var accountInitial = string.IsNullOrWhiteSpace(displayName) ? "?" : displayName[..1].ToUpperInvariant();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1a3050" />
    <meta name="description" content="Shellty Blog — practical guides and thoughtful stories for curious minds." />
    <title>@ViewData["Title"] - Shellty Blog</title>

    <link rel="icon" type="image/png" href="~/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="shortcut icon" href="~/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" />
    <link rel="manifest" href="~/site.webmanifest" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index" aria-label="Shellty Blog home">
                    <span id="navbar-logo" class="navbar-logo" aria-hidden="true"></span>
                    <span>Shell<span class="highlight-ty">ty</span> <span class="brand-suffix">Blog</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : null)"
                               aria-current="@(currentController == "Home" && currentAction == "Index" ? "page" : null)"
                               asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "BlogPost" && currentAction == "Posts" ? "active" : null)"
                               aria-current="@(currentController == "BlogPost" && currentAction == "Posts" ? "page" : null)"
                               asp-controller="BlogPost" asp-action="Posts">Posts</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" && currentAction == "Privacy" ? "active" : null)"
                               aria-current="@(currentController == "Home" && currentAction == "Privacy" ? "page" : null)"
                               asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>

                        @if (isSignedIn && User.IsInRole("Admin"))
                        {
                            <li class="nav-item nav-write-item">
                                <a class="btn nav-write-button" asp-controller="BlogPost" asp-action="CreatePost">
                                    <i class="bi bi-pencil-square" aria-hidden="true"></i> Write
                                </a>
                            </li>
                        }

                        @if (isSignedIn)
                        {
                            <li class="nav-item dropdown account-menu">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="account-avatar" aria-hidden="true">@accountInitial</span>
                                    <span class="account-name">@displayName</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><h2 class="dropdown-header">Administration</h2></li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Requests">
                                                <i class="bi bi-shield-check" aria-hidden="true"></i> Admin Requests
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Users">
                                                <i class="bi bi-people" aria-hidden="true"></i> Manage Users
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="RequestAdmin">
                                                <i class="bi bi-shield-plus" aria-hidden="true"></i> Request Admin
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">
                                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i> Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item auth-links">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item auth-links">
                                <a class="btn nav-register-button" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="page-wrapper">
        <div class="container">
            <partial name="_StatusMessages" />
            <main id="main-content" class="main-content" tabindex="-1">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="footer-custom">
        <div class="container footer-grid">
            <div class="footer-brand">
                <strong>Shell<span class="highlight-ty">ty</span> Blog</strong>
            </div>
            <nav class="footer-links" aria-label="Footer navigation">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="BlogPost" asp-action="Posts">Posts</a>
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </nav>
            <p class="footer-copy">&copy; 2026 Shellty Blog — Made with <i class="bi bi-heart-fill text-danger"></i> for shells</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/logo.js" asp-append-version="true"></script>
    <script>
        renderLogo('navbar-logo', { width: 38, height: 38 });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
