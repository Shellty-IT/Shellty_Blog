@model Shellty_Blog.Models.BlogPost

@{
    ViewData["Title"] = "Create New Post";
    var categories = ViewBag.Categories as List<string>;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <header class="page-header">
            <div>
                <h1 class="section-title">Create New Post</h1>
            </div>
        </header>

        <div class="form-card">
            <form asp-action="CreatePost" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Post Title</label>
                    <input asp-for="Title" class="form-control" placeholder="Enter a catchy title..." />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Category" class="form-label">Category</label>
                    <input asp-for="Category" class="form-control" list="categoryList" placeholder="e.g., Behavior, Lifestyle..." />
                    <datalist id="categoryList">
                        @if (categories != null)
                        {
                            @foreach (var cat in categories)
                            {
                                <option value="@cat"></option>
                            }
                        }
                    </datalist>
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label for="imageInput" class="form-label">Cover Image</label>
                    <input type="file" name="imageFile" id="imageInput" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif" aria-describedby="imageHelp" />
                    <small id="imageHelp" class="text-muted">Max 5 MB. JPG, PNG, WebP or GIF.</small>
                    <div id="imagePreview" class="image-preview mt-3" style="display: none;">
                        <img id="previewImg" src="data:," class="img-fluid rounded-3" alt="Preview" />
                        <button type="button" id="removePreview" class="btn btn-sm btn-outline-danger mt-2">
                            <i class="bi bi-x-lg" aria-hidden="true"></i> Remove
                        </button>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Content" class="form-label">Content</label>
                    <textarea asp-for="Content" class="form-control" rows="10" id="contentArea"
                              placeholder="Write your post content here..."></textarea>
                    <div class="word-counter" id="wordCount">0 words</div>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>

                <div class="form-actions">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-x-lg" aria-hidden="true"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-send" aria-hidden="true"></i> Publish Post
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/post-form.js" asp-append-version="true"></script>
}
