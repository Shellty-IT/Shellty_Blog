@model PostsViewModel

@{
    ViewData["Title"] = "Explore posts";
}

<header class="page-header">
    <div>
        <span class="eyebrow text-primary">Shellty library</span>
        <h1 class="section-title">Explore all posts</h1>
        <p>Search the archive, choose a topic and find your next useful read.</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="CreatePost" class="btn btn-primary">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Write new post
        </a>
    }
</header>

<section class="filter-panel" aria-label="Filter posts">
    <form asp-action="Posts" method="get" class="filter-form" role="search">
        @if (!string.IsNullOrWhiteSpace(Model.Category))
        {
            <input type="hidden" name="category" value="@Model.Category" />
        }
        <div class="search-field">
            <label for="post-search">Search posts</label>
            <div class="input-with-icon">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input id="post-search" name="search" type="search" class="form-control"
                       value="@Model.SearchTerm" placeholder="Title, content or category" />
            </div>
        </div>
        <div class="sort-field">
            <label for="post-sort">Sort by</label>
            <select id="post-sort" name="sort" class="form-select">
                @if (Model.Sort == "newest") { <option value="newest" selected>Newest first</option> } else { <option value="newest">Newest first</option> }
                @if (Model.Sort == "oldest") { <option value="oldest" selected>Oldest first</option> } else { <option value="oldest">Oldest first</option> }
                @if (Model.Sort == "title") { <option value="title" selected>Title A–Z</option> } else { <option value="title">Title A–Z</option> }
            </select>
        </div>
        <button type="submit" class="btn btn-primary filter-submit">Apply filters</button>
    </form>

    @if (Model.Categories.Count > 0)
    {
        <div class="category-filter" aria-label="Filter by category">
            <a asp-action="Posts" asp-route-search="@Model.SearchTerm" asp-route-sort="@Model.Sort"
               class="category-chip @(string.IsNullOrWhiteSpace(Model.Category) ? "active" : null)"
               aria-current="@(string.IsNullOrWhiteSpace(Model.Category) ? "true" : null)">All topics</a>
            @foreach (var category in Model.Categories)
            {
                <a asp-action="Posts" asp-route-search="@Model.SearchTerm" asp-route-category="@category" asp-route-sort="@Model.Sort"
                   class="category-chip @(Model.Category == category ? "active" : null)"
                   aria-current="@(Model.Category == category ? "true" : null)">@category</a>
            }
        </div>
    }
</section>

<div class="results-toolbar" aria-live="polite">
    <p><strong>@Model.TotalCount</strong> @(Model.TotalCount == 1 ? "post" : "posts") found</p>
    @if (Model.HasActiveFilters)
    {
        <a asp-action="Posts" asp-route-sort="@Model.Sort" class="clear-filters">
            Clear filters <i class="bi bi-x-lg" aria-hidden="true"></i>
        </a>
    }
</div>

@if (Model.Posts.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-search" aria-hidden="true"></i>
        <h2>No matching posts</h2>
        <p>Try another phrase or remove the active category filter.</p>
        <a asp-action="Posts" class="btn btn-primary">Show all posts</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var post in Model.Posts)
        {
            <div class="col-md-6 col-xl-4">
                <partial name="_PostCard" model="post" />
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="pagination-wrap" aria-label="Posts pagination">
            <ul class="pagination">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : null)">
                    <a class="page-link" asp-action="Posts" asp-route-search="@Model.SearchTerm" asp-route-category="@Model.Category"
                       asp-route-sort="@Model.Sort" asp-route-page="@(Model.CurrentPage - 1)" aria-label="Previous page">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i><span>Previous</span>
                    </a>
                </li>
                @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                {
                    <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : null)">
                        <a class="page-link" asp-action="Posts" asp-route-search="@Model.SearchTerm" asp-route-category="@Model.Category"
                           asp-route-sort="@Model.Sort" asp-route-page="@pageNumber"
                           aria-current="@(pageNumber == Model.CurrentPage ? "page" : null)">@pageNumber</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : null)">
                    <a class="page-link" asp-action="Posts" asp-route-search="@Model.SearchTerm" asp-route-category="@Model.Category"
                       asp-route-sort="@Model.Sort" asp-route-page="@(Model.CurrentPage + 1)" aria-label="Next page">
                        <span>Next</span><i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
}
