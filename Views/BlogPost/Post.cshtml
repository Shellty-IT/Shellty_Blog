@model PostDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

<nav aria-label="Breadcrumb" class="article-breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-action="Posts">All Posts</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
    </ol>
</nav>

<article class="article-shell">
    <header class="article-header">
        @if (!string.IsNullOrWhiteSpace(Model.Category))
        {
            <a asp-action="Posts" asp-route-category="@Model.Category" class="badge badge-category">@Model.Category</a>
        }
        <h1>@Model.Title</h1>
        <div class="article-meta" aria-label="Article details">
            <span><i class="bi bi-calendar3" aria-hidden="true"></i> @Model.CreatedDate.ToString("MMMM dd, yyyy")</span>
            <span><i class="bi bi-clock" aria-hidden="true"></i> @Model.ReadingTimeMinutes min read</span>
            @if (Model.ModifiedDate.HasValue)
            {
            <span><i class="bi bi-pencil" aria-hidden="true"></i> Last updated: @Model.ModifiedDate.Value.ToString("MMMM dd, yyyy")</span>
            }
        </div>
    </header>

    @if (Model.HasImage)
    {
        <figure class="article-cover">
            <img src="@Url.Action("GetImage", "BlogPost", new { id = Model.Id })"
                 alt="@Model.Title" loading="eager" />
        </figure>
    }

    <div class="post-content">@Model.Content</div>

    <footer class="article-footer">
        <a asp-action="Posts" class="section-link">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> All Posts
        </a>
        @if (User.IsInRole("Admin"))
        {
            <div class="article-admin-actions">
                <a asp-action="EditPost" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                    <i class="bi bi-pencil-square" aria-hidden="true"></i> Edit
                </a>
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                    <i class="bi bi-trash" aria-hidden="true"></i> Delete
                </button>
            </div>
        }
    </footer>
</article>

@if (User.IsInRole("Admin"))
{
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="deleteModalTitle">Confirm Delete</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete <strong>“@Model.Title”</strong>?</p>
                    <p class="text-muted mb-0">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form asp-action="DeletePost" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash" aria-hidden="true"></i> Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
