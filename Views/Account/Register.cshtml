@model RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="auth-shell">
    <section class="auth-card" aria-labelledby="register-title">
        <div class="auth-icon"><i class="bi bi-person-plus" aria-hidden="true"></i></div>
        <h1 id="register-title">Register</h1>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <form asp-action="Register" method="post">
            <div class="mb-3">
                <label asp-for="DisplayName" class="form-label"></label>
                <input asp-for="DisplayName" class="form-control" placeholder="Your name" autocomplete="name" />
                <span asp-validation-for="DisplayName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" aria-describedby="passwordHelp" />
                <small id="passwordHelp" class="text-muted">Use at least 8 characters with uppercase, lowercase and a number.</small>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">
                Register <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </button>
        </form>

        <p class="auth-switch">Already have an account? <a asp-action="Login">Login here</a></p>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
