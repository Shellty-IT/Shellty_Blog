@model HomeViewModel

@{
    ViewData["Title"] = "Home";
}

<section class="hero-section" aria-labelledby="hero-title">
    <div class="hero-content">
        <span class="eyebrow"><i class="bi bi-stars" aria-hidden="true"></i> Explore the world of shells</span>
        <h1 id="hero-title">Stories worth coming out of your <span class="highlight-ty">shell</span> for.</h1>
        <p>Discover practical guides, fresh ideas and thoughtful stories from the Shellty community.</p>

        <form asp-controller="BlogPost" asp-action="Posts" method="get" class="hero-search" role="search">
            <label class="visually-hidden" for="hero-search-input">Search articles</label>
            <i class="bi bi-search" aria-hidden="true"></i>
            <input id="hero-search-input" name="search" type="search" placeholder="Search articles and topics…" />
            <button type="submit" class="btn btn-light">Search</button>
        </form>

        <div class="hero-actions">
            <a asp-controller="BlogPost" asp-action="Posts" class="btn btn-light btn-lg">
                Browse all posts <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="BlogPost" asp-action="CreatePost" class="btn btn-hero-secondary btn-lg">
                    <i class="bi bi-pencil-square" aria-hidden="true"></i> Write a post
                </a>
            }
        </div>
    </div>
    <div class="hero-visual" aria-hidden="true">
        <div id="logo-container"></div>
    </div>
</section>

<div class="content-stats" aria-label="Blog overview">
    <div><strong>@Model.TotalPostCount</strong><span>published posts</span></div>
    <div><strong>@Model.CategoryCount</strong><span>topics to explore</span></div>
    <div><strong>100%</strong><span>made for curious minds</span></div>
</div>

<section class="content-section" aria-labelledby="recent-posts-title">
    <div class="section-heading">
        <div>
            <span class="eyebrow text-primary">Latest from the blog</span>
            <h2 id="recent-posts-title" class="section-title">Recent posts</h2>
        </div>
        <a asp-controller="BlogPost" asp-action="Posts" class="section-link">
            View all posts <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </a>
    </div>

    @if (Model.RecentPosts.Count > 0)
    {
        <div class="row g-4">
            @foreach (var post in Model.RecentPosts)
            {
                <div class="col-md-6 col-xl-4">
                    <partial name="_PostCard" model="post" />
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-journal-richtext" aria-hidden="true"></i>
            <h3>The first story is waiting to be written</h3>
            <p>Check back soon for new articles from the Shellty community.</p>
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="BlogPost" asp-action="CreatePost" class="btn btn-primary">Create the first post</a>
            }
        </div>
    }
</section>

@section Scripts {
    <script>
        renderLogo('logo-container', { width: 360, height: 360 });
    </script>
}
